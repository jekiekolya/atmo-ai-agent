# Copy to .env. Lists every variable the Config module reads.

# Build mode: development | test | production. Next.js sets it; a value here is ignored.
# NODE_ENV=development

# Deployment target: local | dev | staging | production. Required.
# local is a machine serving plain http (yours, CI, e2e); every deployed site uses one of the others.
APP_ENV=local

# PostgreSQL connection string for Prisma. Required.
# Matches the local service in compose.yaml; see the README.
DATABASE_URL=postgresql://atmo:atmo@localhost:5432/atmo_dev?schema=public

# Signs and encrypts the session cookie. Required, at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Idle timeout: a session with no activity for this long expires. Optional, default 28800 (8 h).
SESSION_MAX_AGE_SECONDS=28800

# Hard limit from sign-in, however active the session. Optional, default 86400 (24 h).
# Must not be shorter than SESSION_MAX_AGE_SECONDS.
SESSION_ABSOLUTE_LIFETIME_SECONDS=86400

# Never set AUTH_URL or NEXTAUTH_URL: next-auth reads them itself and would
# override the forwarded host it is told to trust.

# Gemini API key for the chat agent. Required unless AI_FAKE_MODEL=true.
# Create one at https://aistudio.google.com/apikey. A key on a project without billing is the
# free tier: Google may use and human reviewers may read what is sent, so test data only.
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-your-gemini-api-key

# Answer with the deterministic test model instead of Gemini. Optional, default false.
# Refused when APP_ENV=production.
AI_FAKE_MODEL=false

# Longest chat message accepted, in characters (UTF-16 code units). Optional, default 4000.
CHAT_MAX_MESSAGE_LENGTH=4000

# Chat requests one user may start per minute. Optional, default 10.
CHAT_RATE_LIMIT_PER_MINUTE=10

# Tokens (input + output) one user may use in any 24 hours. Optional, default 500000.
CHAT_DAILY_TOKEN_BUDGET=500000

# Most recent messages of a conversation sent to the model. Optional, default 50.
CHAT_HISTORY_LIMIT=50

# Never set NEXT_PUBLIC_ASSISTANT_BASE_URL: assistant-ui would start sending
# conversations to Assistant Cloud.

# ---------------------------------------------------------------------------
# Setup command only (npm run bootstrap) — not read by the application.
# Used once per environment to create the super admin; ignored once it exists.
# ---------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Olena
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Kovalenko
# At least 12 characters and at most 72 bytes.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-long-password
